{
  "info": {
    "_postman_id": "a74eb70a-a5c2-490f-965c-af79d2086f42",
    "name": "FileProcessing.Api",
    "description": "Manual test collection for the file processing API. Import the 'Local' environment alongside this collection, and select the appropriate file from the samples/ folder for each upload request after importing (Postman does not preserve local file paths across machines).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Content-Type is JSON\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Process Valid CSV",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "After importing, select samples/valid-sales.csv from the repository."
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/files/process",
          "host": ["{{baseUrl}}"],
          "path": ["api", "files", "process"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has rowCount\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"rowCount\");",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
