          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Report totals exist\", function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"totalAttempts\");",
              "    pm.expect(json).to.have.property(\"successfulAttempts\");",
              "    pm.expect(json).to.have.property(\"failedAttempts\");",
              "});"
            ]
          }
